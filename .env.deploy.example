# Copy to .env.deploy (git-ignored) and fill in your cPanel FTP account.
FTP_SERVER=ftp.adrik.me
FTP_USERNAME=you@adrik.me
FTP_PASSWORD=
# Folder on the server the site lives in, relative to the FTP account's root.
# For the main cPanel account this is usually public_html/ ; for an
# FTP account scoped to the site folder it is usually just /
FTP_REMOTE_DIR=public_html/
# true = explicit FTPS (recommended if your host supports it)
FTP_SECURE=true
